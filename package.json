{
  "name": "i",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "bun --filter @i/db db:push",
    "db:studio": "bun --filter @i/db db:studio",
    "db:seed": "bun --filter @i/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "turbo": "^2.5.9",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.19"
  }
}
