{
  "name": "i",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @i/web test:e2e",
    "db:generate": "bun --filter @i/db db:generate",
    "db:migrate": "bun --filter @i/db db:migrate",
    "db:push": "bun --filter @i/db db:push",
    "db:studio": "bun --filter @i/db db:studio",
    "db:seed": "bun --filter @i/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.5.9",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=24.19"
  },
  "patchedDependencies": {
    "@vidstack/react@1.15.7": "patches/@vidstack%2Freact@1.15.7.patch"
  }
}
