// Renovate：自动提依赖升级 PR（需要在 GitHub 上安装 Renovate App 并授权本仓库）。
// 每周一早上一批；小版本 / 补丁合成一个 PR，大版本要先在 Dependency Dashboard issue 里勾选才会提。
// 每个 PR 都会跑完整 CI（含 Playwright 端到端）：小版本 / 补丁绿了自动合并，大版本绿了再手动合。
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":timezone(Asia/Shanghai)",
    // 所有非大版本升级合成一个 PR，减少噪音
    "group:allNonMajor",
    // 每月刷新一次 bun.lock 里的间接依赖
    ":maintainLockFilesMonthly",
  ],
  schedule: ["before 9am on monday"],
  labels: ["dependencies"],
  // 大版本需要在 Dependency Dashboard 里手动批准
  major: { dependencyDashboardApproval: true },
  packageRules: [
    // 小版本 / 补丁 CI 全绿后自动合并。仓库没开 GitHub 自动合并、main 也没有必需检查，
    // 交给 GitHub 合会不等 CI —— 所以关掉 platformAutomerge，由 Renovate 等分支状态全绿后自己合
    {
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      platformAutomerge: false,
    },
    // config:recommended 里的 workarounds:typesNodeVersioning 只匹配 npm 管理器，本仓库走的是 bun 管理器，这里补上：
    // @types/node 用 node 版本规则（大版本进入 LTS 才算稳定），不会抢在 .node-version / Dockerfile 前面升
    {
      matchManagers: ["bun"],
      matchPackageNames: ["@types/node"],
      versioning: "node",
    },
    // 大版本按“家族”合并，相关包一起升
    {
      matchUpdateTypes: ["major"],
      matchDepNames: ["node", "@types/node"],
      groupName: "Node.js",
      prBodyNotes: [
        "Node 大版本：.node-version、Dockerfile、@types/node 一起升；确认 react-router-hono-server 等支持新版本。",
      ],
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["react", "react-dom", "@types/react", "@types/react-dom"],
      groupName: "React",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["drizzle-orm", "drizzle-kit"],
      groupName: "Drizzle",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["@orpc/**"],
      groupName: "oRPC",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["bun", "oven/bun"],
      groupName: "Bun",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres"],
      matchUpdateTypes: ["major"],
      prBodyNotes: [
        "⚠️ Postgres 大版本不能直接合并：数据目录要先迁移（pg_dump / pg_restore 或 pg_upgrade），否则新容器起不来。",
      ],
    },
    // satori 刻意停在 0.32：之后的版本带 harfbuzzjs，分享卡片的服务端构建要重新验证
    {
      matchPackageNames: ["satori"],
      groupName: "satori",
      dependencyDashboardApproval: true,
      // 要人工在生产构建里验证出图，不自动合并
      automerge: false,
      prBodyNotes: [
        "satori 停在 0.32 是因为之后的版本引入 harfbuzzjs；升级后在生产构建里实际打开 /og.png 确认能出图。",
      ],
    },
    // 只用于一次性迁移的旧 MinIO：不跟踪
    {
      matchPackageNames: ["minio/minio"],
      enabled: false,
    },
  ],
  customManagers: [
    // biome.json 的 $schema 版本跟着 @biomejs/biome 走（同名依赖会进同一个 PR）
    {
      customType: "regex",
      managerFilePatterns: ["/^biome\\.json$/"],
      matchStrings: ['"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json"'],
      depNameTemplate: "@biomejs/biome",
      datasourceTemplate: "npm",
    },
  ],
}
